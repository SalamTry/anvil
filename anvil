#!/bin/zsh
# anvil — forge digital knowledge into printed study pages
# Usage: anvil [--paper=a5|a6|a4|letter] [--scheme=name] [--theme=name] [--preview] [--no-print] <file.md>
#        echo "markdown" | anvil [--paper=a5|a6|a4|letter] [--scheme=name] [--theme=name] [--preview] [--no-print]

set -euo pipefail

# ══════════════════════════════════════════════════════════════
# Config — resolve everything needed to describe the rendering job
# ══════════════════════════════════════════════════════════════

# Platform
case "$(uname -s)" in
  Darwin) TEX_PATH="/Library/TeX/texbin"; OPEN_CMD="open"; PLATFORM="darwin" ;;
  Linux)  TEX_PATH="/usr/local/texlive/2024/bin/x86_64-linux"; OPEN_CMD="xdg-open"; PLATFORM="linux" ;;
  *)      TEX_PATH=""; OPEN_CMD="open"; PLATFORM="other" ;;
esac

# Desktop notification — fires after a successful print
notify() {
  local title="$1" message="$2"
  case "$PLATFORM" in
    darwin)
      osascript -e "display notification \"$message\" with title \"$title\"" 2>/dev/null || true
      ;;
    linux)
      if command -v notify-send >/dev/null 2>&1; then
        notify-send "$title" "$message" 2>/dev/null || true
      fi
      ;;
  esac
}

# Paths
TEMPLATE_DIR="$HOME/anvil"
TEMPLATE="$TEMPLATE_DIR/sketch-page.tex"
COUNTER_FILE="$TEMPLATE_DIR/.entry-counter"
OUTPUT_DIR="$HOME/anvil/output"
mkdir -p "$OUTPUT_DIR"

# CLI arguments
PAPER="a5"
SCHEME=""
THEME="dot"
PREVIEW=false
NO_PRINT=false
INPUT_FILE=""

SCHEME_DIR="$TEMPLATE_DIR/schemes"
THEMES_DIR="$TEMPLATE_DIR/themes"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      local_schemes=$(ls "$SCHEME_DIR"/*.sh 2>/dev/null | xargs -I{} basename {} .sh | paste -sd', ' -)
      local_themes=$(ls -d "$THEMES_DIR"/*/ 2>/dev/null | xargs -I{} basename {} | paste -sd', ' -)
      echo "anvil — forge digital knowledge into printed study pages"
      echo ""
      echo "Usage: anvil [options] <file.md>"
      echo "       echo \"markdown\" | anvil [options]"
      echo ""
      echo "Options:"
      echo "  --paper=SIZE    Paper size: a5 (default), a6, a4, letter"
      echo "  --scheme=NAME   Color/font scheme: ${local_schemes:-pencil} (default: pencil)"
      echo "  --theme=NAME    Background theme: ${local_themes:-dot} (default: dot)"
      echo "  --preview       Open PDF after generating"
      echo "  --no-print      Skip sending to printer"
      echo "  -h, --help      Show this help"
      echo ""
      echo "Diagrams:"
      echo "  Use \`\`\`d2 fenced code blocks in markdown for sketch-style diagrams."
      echo "  Requires: brew install d2 librsvg"
      exit 0 ;;
    --paper=*) PAPER="${1#--paper=}"; shift ;;
    --paper)   PAPER="$2"; shift 2 ;;
    --scheme=*) SCHEME="${1#--scheme=}"; shift ;;
    --scheme)   SCHEME="$2"; shift 2 ;;
    --theme=*) THEME="${1#--theme=}"; shift ;;
    --theme)   THEME="$2"; shift 2 ;;
    --a6) PAPER="a6"; shift ;;
    --a5) PAPER="a5"; shift ;;
    --preview) PREVIEW=true; shift ;;
    --no-print) NO_PRINT=true; shift ;;
    *) INPUT_FILE="$1"; shift ;;
  esac
done

# Paper presets
case "$PAPER" in
  a5)     PAPER_LATEX="a5paper";     PAPER_MARGIN="10mm"; PAPER_TOP="10mm"; PAPER_BOTTOM="10mm"; PAPER_MEDIA="a5" ;;
  a6)     PAPER_LATEX="a6paper";     PAPER_MARGIN="5mm";  PAPER_TOP="10mm"; PAPER_BOTTOM="5mm";  PAPER_MEDIA="a6" ;;
  a4)     PAPER_LATEX="a4paper";     PAPER_MARGIN="15mm"; PAPER_TOP="15mm"; PAPER_BOTTOM="10mm"; PAPER_MEDIA="a4" ;;
  letter) PAPER_LATEX="letterpaper"; PAPER_MARGIN="15mm"; PAPER_TOP="15mm"; PAPER_BOTTOM="10mm"; PAPER_MEDIA="letter" ;;
  *) echo "Error: unknown paper size '$PAPER'. Valid: a5, a6, a4, letter" >&2; exit 1 ;;
esac

# Scheme — colors & fonts
typeset -A COLORS=(
  [gridline]=CCCCCC
  [gridmajor]=999999
  [accent]=555555
  [muted]=888888
  [body]=333333
)
FONT_MAIN="Indie Flower"
FONT_BOLD=""
FONT_MONO="Menlo"

if [[ -n "$SCHEME" ]]; then
  SCHEME_FILE="$SCHEME_DIR/${SCHEME}.sh"
  if [[ ! -f "$SCHEME_FILE" ]]; then
    available=$(ls "$SCHEME_DIR"/*.sh 2>/dev/null | xargs -I{} basename {} .sh | paste -sd', ' -)
    echo "Error: unknown scheme '$SCHEME'. Available: ${available:-none}" >&2
    exit 1
  fi
  typeset -A _DEFAULTS=("${(@kv)COLORS}")
  source "$SCHEME_FILE"
  for key in gridline gridmajor accent muted body; do
    [[ -z "${COLORS[$key]:-}" ]] && COLORS[$key]="${_DEFAULTS[$key]}"
  done
  : "${FONT_MAIN:=Indie Flower}"
  : "${FONT_MONO:=Menlo}"
fi

# ══════════════════════════════════════════════════════════════
# Background theme — pluggable grid/background generator
# ══════════════════════════════════════════════════════════════

if [[ ! "$THEME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "Error: invalid theme name '$THEME'. Use letters, digits, hyphens, or underscores." >&2
  exit 1
fi

THEME_GENERATOR="$THEMES_DIR/$THEME/generate"
if [[ ! -f "$THEME_GENERATOR" ]]; then
  available=$(ls -d "$THEMES_DIR"/*/ 2>/dev/null | xargs -I{} basename {} | paste -sd', ' -)
  echo "Error: unknown theme '$THEME'. Available: ${available:-none}" >&2
  exit 1
fi

# Entry counter — after all validation so bad inputs don't inflate it
if [[ -f "$COUNTER_FILE" ]]; then
  ENTRY_NUM=$(($(cat "$COUNTER_FILE") + 1))
else
  ENTRY_NUM=1
fi
echo "$ENTRY_NUM" > "$COUNTER_FILE"
ENTRY_PADDED=$(printf "%03d" "$ENTRY_NUM")

DATE=$(date "+%Y-%m-%d")

GRID_PNG=$("$THEME_GENERATOR" "$PAPER" "${COLORS[gridline]}" "${COLORS[gridmajor]}")

# ══════════════════════════════════════════════════════════════
# Pipeline — (markdown, config) → PDF
# ══════════════════════════════════════════════════════════════

# Read input
if [[ -n "$INPUT_FILE" && -f "$INPUT_FILE" ]]; then
  MARKDOWN=$(cat "$INPUT_FILE")
  BASENAME=$(basename "$INPUT_FILE" .md)
else
  MARKDOWN=$(cat -)
  BASENAME="note"
fi

OUTPUT_NAME="${ENTRY_PADDED}-${BASENAME}-${DATE}"
OUTPUT_PDF="$OUTPUT_DIR/${OUTPUT_NAME}.pdf"

[[ -n "$TEX_PATH" ]] && export PATH="$TEX_PATH:$PATH"

pandoc \
  -f markdown+hard_line_breaks \
  --template="$TEMPLATE" \
  --pdf-engine=lualatex \
  --lua-filter="$TEMPLATE_DIR/anvil-filter.lua" \
  -M source-file="$BASENAME" \
  -V date="$DATE" \
  -V entry-number="$ENTRY_PADDED" \
  -V color-gridline="${COLORS[gridline]}" \
  -V color-gridmajor="${COLORS[gridmajor]}" \
  -V color-accent="${COLORS[accent]}" \
  -V color-muted="${COLORS[muted]}" \
  -V color-body="${COLORS[body]}" \
  -V font-main="$FONT_MAIN" \
  ${FONT_BOLD:+-V font-bold="$FONT_BOLD"} \
  -V font-mono="$FONT_MONO" \
  -V paper-size="$PAPER_LATEX" \
  -V paper-margin="$PAPER_MARGIN" \
  -V paper-top="$PAPER_TOP" \
  -V paper-bottom="$PAPER_BOTTOM" \
  ${GRID_PNG:+-V grid-bg="$GRID_PNG"} \
  -o "$OUTPUT_PDF" \
  <<< "$MARKDOWN"

echo "✦ Generated: $OUTPUT_PDF"
echo "  Paper: $(echo $PAPER | tr '[:lower:]' '[:upper:]') | Entry: #${ENTRY_PADDED} | Date: $DATE"

# ══════════════════════════════════════════════════════════════
# Delivery — preview and print
# ══════════════════════════════════════════════════════════════

if $PREVIEW; then
  $OPEN_CMD "$OUTPUT_PDF"
fi

if ! $NO_PRINT; then
  PRINTER=$(lpstat -d 2>/dev/null | sed 's/.*: //' || true)
  if [[ -n "$PRINTER" ]]; then
    LP_OUTPUT=$(lp -d "$PRINTER" -o media="${PAPER_MEDIA}" "$OUTPUT_PDF" 2>&1)
    JOB_ID=$(echo "$LP_OUTPUT" | grep -o '[^ ]*-[0-9]*' | head -1)
    echo "  Sent to printer: $PRINTER (job $JOB_ID)"

    # Wait for the print job to complete (detect via IPP: processing → idle)
    PRINT_TIMEOUT=300
    POLL_INTERVAL=2
    ELAPSED=0
    SPINNER_CHARS='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    SPINNER_IDX=0
    SAW_PROCESSING=false

    # Resolve printer IPP URI for status checks
    PRINTER_URI=$(lpstat -v "$PRINTER" 2>/dev/null | sed 's/.*: //' || true)

    # Let the printer pick up the job before first check
    sleep "$POLL_INTERVAL"

    while true; do
      # Query printer state (single IPP call per cycle)
      IPP_STATUS=""
      PRINTER_STATE_ENUM=""
      if [[ -n "$PRINTER_URI" ]]; then
        IPP_STATUS=$(ipptool -tv "$PRINTER_URI" get-printer-attributes.test 2>/dev/null \
          | grep -E 'printer-state[ (]|printer-state-reasons|printer-alert-description' || true)
        PRINTER_STATE_ENUM=$(echo "$IPP_STATUS" | grep 'printer-state (enum)' | sed 's/.*= //' | head -1 || true)
        PRINTER_REASONS=$(echo "$IPP_STATUS" | grep 'printer-state-reasons' | head -1 || true)
        PRINTER_ALERT=$(echo "$IPP_STATUS" | grep 'printer-alert-description' | sed 's/.*= //' | head -1 || true)
      fi

      # Track that the printer started processing
      if [[ "$PRINTER_STATE_ENUM" == "processing" ]]; then
        SAW_PROCESSING=true
      fi

      # Completion: printer went idle after processing our job
      if $SAW_PROCESSING && [[ "$PRINTER_STATE_ENUM" == "idle" ]]; then
        printf "\r\033[K" >&2
        echo "  ✓ Printed on $PRINTER"
        notify "anvil" "#${ENTRY_PADDED} printed on ${PRINTER}"
        break
      fi

      # Error: printer stopped with a hardware problem
      if [[ "$PRINTER_STATE_ENUM" == "stopped" ]] && echo "$PRINTER_REASONS" | grep -qiE 'media-empty|media-needed|media-jam|offline|shutdown|door-open|cover-open|tray-missing'; then
        printf "\r\033[K" >&2

        # Map raw IPP alerts to friendly messages
        case "$PRINTER_ALERT" in
          trayEmpty|"")   ERROR_MSG="Out of paper" ;;
          mediaJam)       ERROR_MSG="Paper jam" ;;
          doorOpen)       ERROR_MSG="Printer door/cover open" ;;
          *)              ERROR_MSG="$PRINTER_ALERT" ;;
        esac
        : "${ERROR_MSG:=Printer error}"

        echo "  ⚠ $ERROR_MSG" >&2
        if [[ -t 0 ]] || [[ -e /dev/tty ]]; then
          printf "  Fix the printer and retry? (y/n) " >&2
          read -r REPLY </dev/tty 2>/dev/null || REPLY="n"
          if [[ "$REPLY" =~ ^[Yy]$ ]]; then
            cupsenable "$PRINTER" 2>/dev/null || true
            SAW_PROCESSING=false
            ELAPSED=0
            continue
          fi
        fi
        cancel "$JOB_ID" 2>/dev/null || true
        echo "  ✗ Cancelled job $JOB_ID"
        exit 1
      fi

      # Show spinner
      SPIN_CHAR="${SPINNER_CHARS:$SPINNER_IDX:1}"
      printf "\r  %s Printing... %ds" "$SPIN_CHAR" "$ELAPSED" >&2
      SPINNER_IDX=$(( (SPINNER_IDX + 1) % ${#SPINNER_CHARS} ))

      sleep "$POLL_INTERVAL"
      ELAPSED=$((ELAPSED + POLL_INTERVAL))
      if [[ $ELAPSED -ge $PRINT_TIMEOUT ]]; then
        printf "\r\033[K" >&2
        echo "  ⚠ Timeout: job $JOB_ID still in queue after ${PRINT_TIMEOUT}s"
        exit 2
      fi
    done
  else
    echo "  ⚠ No default printer set. Use: lpadmin -d <printer-name>"
    echo "  PDF saved — print manually or set up printer first."
  fi
fi
