#!/usr/bin/env python3
"""Generate a dot-grid PNG background for anvil study pages.

Usage: grid-png <paper-size> <minor-hex> <major-hex>

  paper-size  One of: a5, a6, a4, letter
  minor-hex   Hex color for minor dots (e.g. CCCCCC)
  major-hex   Hex color for major dots (e.g. 999999)

Outputs: path to the generated (or cached) PNG on stdout.

The grid matches the TikZ spec in sketch-page.tex:
  - Minor dots every 5 mm, radius 0.45 pt
  - Major dots every 15 mm, radius 0.85 pt
  - 300 DPI

Cache: results are stored by paper+colors hash in $ANVIL_GRID_CACHE
(default: ~/.cache/anvil/grids). A cache hit prints the path and exits.
"""

import hashlib
import os
import sys

from PIL import Image, ImageDraw

# ── Constants ──────────────────────────────────────────────────

DPI = 300
MM_PER_INCH = 25.4

# Paper sizes in mm (width, height)
PAPER_SIZES = {
    "a5":     (148,   210),
    "a6":     (105,   148),
    "a4":     (210,   297),
    "letter": (215.9, 279.4),
}

# Grid geometry
MINOR_SPACING_MM = 5    # dot every 5 mm
MAJOR_SPACING_MM = 15   # bold dot every 15 mm
MINOR_RADIUS_PT  = 0.45
MAJOR_RADIUS_PT  = 0.85


def mm_to_px(mm):
    """Convert millimeters to pixels at DPI."""
    return round(mm * DPI / MM_PER_INCH)


def pt_to_px(pt):
    """Convert points to pixels at DPI."""
    return pt * DPI / 72


# ── Grid rendering ────────────────────────────────────────────

def generate_grid(paper, minor_hex, major_hex):
    """Render a dot-grid PNG and return the PIL Image."""
    w_mm, h_mm = PAPER_SIZES[paper]
    w_px, h_px = mm_to_px(w_mm), mm_to_px(h_mm)

    minor_color = f"#{minor_hex}"
    major_color = f"#{major_hex}"

    # Use RGBA for antialiased circles, composite onto white at end
    img = Image.new("RGBA", (w_px, h_px), (255, 255, 255, 255))
    draw = ImageDraw.Draw(img)

    minor_spacing_px = MINOR_SPACING_MM * DPI / MM_PER_INCH
    major_spacing_px = MAJOR_SPACING_MM * DPI / MM_PER_INCH
    minor_r = pt_to_px(MINOR_RADIUS_PT)
    major_r = pt_to_px(MAJOR_RADIUS_PT)

    # Count dots along each axis
    cols = int(w_px / minor_spacing_px) + 1
    rows = int(h_px / minor_spacing_px) + 1
    major_every = round(MAJOR_SPACING_MM / MINOR_SPACING_MM)  # 3

    # Draw all dots — minor first, then major overwrites at intersections
    for row in range(rows):
        cy = round(row * minor_spacing_px)
        if cy >= h_px:
            continue
        for col in range(cols):
            cx = round(col * minor_spacing_px)
            if cx >= w_px:
                continue

            is_major = (row % major_every == 0) and (col % major_every == 0)
            if is_major:
                r = major_r
                color = major_color
            else:
                r = minor_r
                color = minor_color

            draw.ellipse(
                [cx - r, cy - r, cx + r, cy + r],
                fill=color,
            )

    # Flatten to RGB (no transparency needed in output)
    result = Image.new("RGB", (w_px, h_px), (255, 255, 255))
    result.paste(img, mask=img.split()[3])
    return result


# ── Caching ───────────────────────────────────────────────────

def cache_key(paper, minor_hex, major_hex):
    """Deterministic hash for a (paper, minor, major) triple."""
    blob = f"{paper}:{minor_hex}:{major_hex}".encode()
    return hashlib.sha256(blob).hexdigest()[:16]


def cache_dir():
    """Resolve the cache directory (respects $ANVIL_GRID_CACHE)."""
    d = os.environ.get("ANVIL_GRID_CACHE", "")
    if not d:
        d = os.path.join(os.path.expanduser("~"), ".cache", "anvil", "grids")
    os.makedirs(d, exist_ok=True)
    return d


# ── CLI ───────────────────────────────────────────────────────

def main():
    if len(sys.argv) != 4:
        print(
            f"Usage: {os.path.basename(sys.argv[0])} <paper-size> <minor-hex> <major-hex>\n"
            f"Paper sizes: {', '.join(sorted(PAPER_SIZES))}",
            file=sys.stderr,
        )
        sys.exit(1)

    paper = sys.argv[1].lower()
    minor_hex = sys.argv[2].upper().lstrip("#")
    major_hex = sys.argv[3].upper().lstrip("#")

    if paper not in PAPER_SIZES:
        print(
            f"Error: unknown paper size '{paper}'. "
            f"Valid: {', '.join(sorted(PAPER_SIZES))}",
            file=sys.stderr,
        )
        sys.exit(1)

    key = cache_key(paper, minor_hex, major_hex)
    out_path = os.path.join(cache_dir(), f"grid-{paper}-{key}.png")

    if os.path.isfile(out_path):
        print(out_path)
        sys.exit(0)

    img = generate_grid(paper, minor_hex, major_hex)
    img.save(out_path, "PNG", dpi=(DPI, DPI), optimize=True)
    print(out_path)


if __name__ == "__main__":
    main()
